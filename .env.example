NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://agentic_web_research:agentic_web_research@localhost:5432/agentic_web_research
APP_SECRET=replace-with-a-long-random-secret
